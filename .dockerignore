# Never send these into the build context - irrelevant to the image and
# can leak credentials accidentally copied nearby.

.git/
.gitignore
README.md
AGENTS.md
docs/
.github/
Makefile
.dockerignore

# Local editor files
.vscode/
.idea/
*.swp

# Anything that might hold a credential near the repo root
*.crx
*.pem
*.pfx
secrets/

# Local caches, reports and credentials are never build inputs.
.validation/
reports/
tests/
.venv/
__pycache__/
.env
.env.*
**/.ssh/
**/.azure/
**/.Azure/
**/.kube/
**/IdentityCache/
**/.mg/
**/.IdentityService/
**/*.key
**/*.p12
**/local.settings.json
config/powershell/secret.ps1
